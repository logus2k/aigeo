@font-face { font-family: 'Roboto'; src: url('../fonts/Roboto-Thin.ttf') format('truetype'); font-weight: 100; font-style: normal; font-display: swap; }
@font-face { font-family: 'Roboto'; src: url('../fonts/Roboto-Light.ttf') format('truetype'); font-weight: 300; font-style: normal; font-display: swap; }
@font-face { font-family: 'Roboto'; src: url('../fonts/Roboto-Regular.ttf') format('truetype'); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: 'Roboto'; src: url('../fonts/Roboto-Medium.ttf') format('truetype'); font-weight: 500; font-style: normal; font-display: swap; }
@font-face { font-family: 'Roboto'; src: url('../fonts/Roboto-Bold.ttf') format('truetype'); font-weight: 700; font-style: normal; font-display: swap; }

:root {
  --font-sans: 'Roboto', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --bg: #fbfcfe;
  --panel: #ffffff;
  --border: #d8dee9;
  --text: #1c2733;
  --muted: #66727f;
  --accent: #3182bd;
  --map-bg: #ffffff;        /* light theme: white map background */
  --country-line: #aab3bd;  /* default border between countries */
  --country-hover: #ffcc00; /* hovered country outline */
  --btn-shadow: 0 2px 8px rgba(0,0,0,.18);
}
body.dark {
  --map-bg: #000000;        /* dark theme: black map background */
  --country-line: #5c6672;
  --country-hover: #ffcc00;
  --btn-shadow: 0 0 0 1px rgba(255,255,255,.25), 0 2px 10px rgba(255,255,255,.18);
}
* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  overflow: hidden;            /* full-viewport map; everything else floats in panels */
  font: 14px/1.45 var(--font-sans);
  color: var(--text);
  background: var(--bg);
}

/* Map fills the whole viewport. */
#svg {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: var(--map-bg);
  cursor: grab;
  display: block;
}
#svg.grabbing { cursor: grabbing; }

/* Settings gear, fixed at the bottom-left corner. */
#gearBtn {
  position: fixed;
  left: 16px;
  bottom: 16px;
  z-index: 20;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--panel);
  color: var(--muted);
  cursor: pointer;
  box-shadow: var(--btn-shadow);
}
#gearBtn:hover { color: var(--accent); border-color: var(--accent); }

/* Light/dark theme toggle, fixed at the top-right corner. */
#themeBtn {
  position: fixed;
  right: 16px;
  top: 16px;
  z-index: 20;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--panel);
  color: var(--muted);
  cursor: pointer;
  box-shadow: var(--btn-shadow);
}
#themeBtn:hover { color: var(--accent); border-color: var(--accent); }
#themeBtn .icon-sun { display: none; }
body.dark #themeBtn .icon-moon { display: none; }
body.dark #themeBtn .icon-sun { display: block; }
.country { stroke: var(--country-line); stroke-width: 0.3; transition: fill .15s; cursor: pointer; }
.country.hover { stroke: var(--country-hover); stroke-width: 0.8; }
.country.selected { stroke: #e0a800; stroke-width: 1.8; paint-order: stroke; }

/* ---- jsPanel detail content ----
   Explicit colors throughout: the panel uses a "filled" jsPanel theme, which
   tints inherited content text white — so every text element sets its own color. */
.country-detail {
  padding: 12px 14px;
  font-size: 13px;
  color: var(--text);
  overflow-y: auto;
  overflow-x: hidden;   /* never push values off-screen horizontally */
  height: 100%;
}
.country-detail h4 { margin: 14px 0 4px; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
.country-detail table { width: 100%; border-collapse: collapse; table-layout: fixed; }
.country-detail th {
  width: 46%;
  text-align: left;
  font-weight: 500;
  color: var(--muted);
  padding: 4px 8px 4px 0;
  vertical-align: top;
  word-break: break-word;
}
.country-detail td {
  text-align: right;
  padding: 4px 0;
  color: var(--text);
  word-break: break-word;
}
.detail-meta th, .detail-meta td { border-bottom: 1px solid #f0f2f5; }
.detail-ind tr.grp th { padding-top: 12px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--accent); font-weight: 700; }
.detail-ind tr.cur { background: #eaf3fb; }
.detail-ind tr.cur th, .detail-ind tr.cur td { font-weight: 700; color: var(--accent); }
.country-detail .rank { color: #5a9bd4; font-size: 11px; }
.detail-ind tr.cur .rank { color: var(--accent); }
.country-detail .nd { color: #b6bdc6; font-style: italic; }
.country-detail .wiki {
  display: flex;
  width: fit-content;
  align-items: center;
  gap: 5px;
  margin: 14px auto 0;     /* centered horizontally within the panel */
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #f5f8fc;
  color: var(--accent);
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
}
.country-detail .wiki:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

/* large flag at the top of the panel body */
.detail-flag {
  text-align: left;
  margin: 2px 0 12px;
}
.detail-flag img {
  width: 70px;
  height: auto;
}
/* small flag in the panel header title */
.hdr-flag { width: 18px; height: 12px; vertical-align: middle; }

/* jsPanel header control buttons — constrain the close (X) icon to a normal
   size; without an explicit size the control SVG renders huge. */
.jsPanel .jsPanel-controlbar .jsPanel-btn {
  width: 22px !important;
  height: 20px !important;
  padding: 0 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}
.jsPanel .jsPanel-controlbar .jsPanel-btn span:not(.material-icons),
.jsPanel .jsPanel-controlbar .jsPanel-btn svg:not(.svg-inline--fa) {
  width: 0.8rem !important;
  height: 0.8rem !important;
  margin: 0 !important;
}

/* Panel content base font slightly smaller than jsPanel's 1rem default. */
.jsPanel-content { font-size: 0.8rem; }

/* Panel header: golden title bar, dark title text and dark close (X).
   Round the top corners to match the panel's 8px radius (jsPanel leaves them
   square, so the golden bar pokes out past the rounded panel). */
.jsPanel .jsPanel-hdr,
.jsPanel .jsPanel-titlebar {
  background-color: #ffde5c !important;
  border-radius: 8px 8px 0 0;
}
.jsPanel .jsPanel-titlebar .jsPanel-title { color: #050505 !important; }
.jsPanel .jsPanel-controlbar .jsPanel-btn { color: #050505 !important; }

/* Panel title: jsPanel defaults to small-caps — use normal casing. */
.jsPanel .jsPanel-titlebar .jsPanel-title { font-variant: normal; font-size: 13px; margin-left: 10px; }

/* Close button: replace jsPanel's heavy filled-X glyph with a thin × so it
   reads like a normal window close, not a bold one. */
.jsPanel .jsPanel-btn-close svg { display: none !important; }
.jsPanel .jsPanel-btn-close::before {
  content: "\00d7";
  font-size: 1.15rem;
  font-weight: 400;
  line-height: 1;
  color: currentColor;
}

#tooltip {
  position: fixed;
  display: none;
  pointer-events: none;
  background: var(--text);
  color: #fff;
  padding: 6px 9px;
  border-radius: 6px;
  font-size: 12.5px;
  z-index: 10;
  box-shadow: 0 2px 8px rgba(0,0,0,.25);
}
#tooltip .rank { color: #9ec9e8; }

/* ---- settings panel content ---- */
.settings-wrap { padding: 12px 14px; }
.settings-body fieldset {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 10px 8px;
  margin: 0 0 12px;
}
.settings-body fieldset:last-child { margin-bottom: 0; }
.settings-body legend { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 0 4px; }
.settings-body select { font: inherit; width: 100%; padding: 5px 6px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); color: var(--text); }
.settings-body .opt-col { display: flex; flex-direction: column; gap: 4px; }
.settings-body label { cursor: pointer; display: flex; align-items: center; gap: 6px; }

/* ---- indicators panel content ---- */
.indicator-list { display: flex; flex-direction: column; padding: 6px; }
.ind-group + .ind-group { margin-top: 2px; }
.ind-group-hdr {
  display: flex;
  align-items: center;
  gap: 7px;
  width: 100%;
  padding: 6px 8px;
  border: 0;
  border-radius: 6px;
  background: #f1f4f8;
  color: var(--text);
  font: inherit;
  font-weight: 600;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}
.ind-group-hdr:hover { background: #e7edf4; }
.ind-caret { display: inline-block; transition: transform .12s; color: var(--muted); font-size: 10px; }
.ind-group-hdr.open .ind-caret { transform: rotate(90deg); }
.ind-group-label { flex: 1; }
.ind-group-count { font-size: 11px; color: var(--muted); font-weight: 400; }
.ind-group-body { padding: 2px 0 4px 6px; }
.ind-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 5px 10px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--text);
  font: inherit;
  text-align: left;
  cursor: pointer;
}
.ind-item:hover { background: #eef3f8; }
.ind-item.active { background: #b8e9c9; color: #050505; }
.ind-item .ind-count { font-size: 11px; color: var(--muted); }
.ind-item.active .ind-count { color: #050505; }
.ind-left { display: flex; align-items: center; gap: 9px; min-width: 0; }
.ind-icon { width: 16px; height: 16px; flex: none; color: var(--muted); }
.ind-item.active .ind-icon { color: #050505; }
.ind-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---- legend panel content (panel auto-sizes to this) ---- */
.legend-body { padding: 12px 14px; }
.legend-title { font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; white-space: nowrap; }
.legend-bar { height: 12px; border-radius: 4px; border: 1px solid var(--border); }
/* title + labels set the width (no wrap); the note wraps within that width */
.legend-labels { display: flex; justify-content: space-between; gap: 16px; font-size: 11px; color: var(--muted); margin-top: 3px; white-space: nowrap; }
.legend-note { font-size: 11px; color: var(--muted); margin-top: 6px; }

/* error banner only (no per-render status text) */
#status { position: fixed; left: 16px; top: 16px; z-index: 30; display: none; max-width: 60vw; padding: 8px 12px; background: #fff3f3; border: 1px solid #e0b4b4; border-radius: 8px; color: #a33; font-size: 12.5px; }
